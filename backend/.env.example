# Copy to .env and adjust. Never commit a real .env.
COOKBOOK_DATABASE_URL=postgresql+psycopg://localhost:5432/cookbook
# Only "dev" (fixed single local user, no auth) is implemented in this slice.
# The server refuses to start with any other value. Do not expose it publicly.
COOKBOOK_AUTH_MODE=dev
# Used by the test suite. Its tables are dropped and recreated on every run.
COOKBOOK_TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/cookbook_test
# Caption extraction: "fake" (rule-based, no model), "ollama" (local model; run
# `brew services start ollama` and `ollama pull qwen2.5:7b` first) or "anthropic"
# (Claude over the API: captions are sent to Anthropic and each import costs money).
COOKBOOK_EXTRACTION_PROVIDER=fake
COOKBOOK_OLLAMA_MODEL=qwen2.5:7b
# COOKBOOK_ANTHROPIC_API_KEY=sk-ant-...
# COOKBOOK_ANTHROPIC_MODEL=claude-haiku-5-5
