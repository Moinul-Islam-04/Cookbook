# Local development settings. Copy to .env and adjust. Never commit a real .env.
# The deployed server's settings are in deploy/env.example.
COOKBOOK_DATABASE_URL=postgresql+psycopg://localhost:5432/cookbook
# "dev": no authentication, every request is the owner (127.0.0.1 only).
# "token": every request needs a device token (`python -m app.tokens create`), or Google
# sign-in if COOKBOOK_GOOGLE_CLIENT_IDS is set.
COOKBOOK_AUTH_MODE=dev
# COOKBOOK_GOOGLE_CLIENT_IDS=752334209823-m3fkevjvqjjohu4qj8utvm4h211qaqfi.apps.googleusercontent.com
# Used by the test suite. Its tables are dropped and recreated on every run.
COOKBOOK_TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/cookbook_test
# Caption extraction: "fake" (rule-based, no model) or "anthropic" (Claude over the API:
# captions are sent to Anthropic and each import costs money).
COOKBOOK_EXTRACTION_PROVIDER=fake
# COOKBOOK_ANTHROPIC_API_KEY=sk-ant-...
# COOKBOOK_ANTHROPIC_MODEL=claude-haiku-5-5
# Photos: "memory" locally (lost when the server restarts); the server uses "s3".
COOKBOOK_STORAGE_BACKEND=memory
